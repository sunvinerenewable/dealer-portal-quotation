    # ── Supabase (Client-side — the anon/publishable key is safe to expose) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase (Server-side only — NEVER expose in VITE_ vars) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── JWT Authentication ─────────────────────────────────────────
# Must be >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-96-hex-char-random-string

# ── Gemini AI (Server-side only — NEVER expose in VITE_ vars) ──
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# ── Database (for seed scripts only) ──────────────────────────
# Get from Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-x-region.pooler.supabase.com:5432/postgres

# ── Maps APIs (Client-side — restrict by HTTP referrer in Google Console) ──
VITE_GEOAPIFY_API_KEY=your-geoapify-key
VITE_GOOGLE_PLACES_API_KEY=your-google-places-key

# ── Cloudflare R2 Storage (10 GB Free, $0 Egress) ──────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sunvine-documents
R2_PUBLIC_DOMAIN=https://pub-yourdomain.r2.dev

# ── Vercel Environment ─────────────────────────────────────────
NODE_ENV=development
# VERCEL_ENV=production  (set automatically by Vercel)

# ── Slack Crash Reporting & Notifications ────────────────────────
VITE_SLACK_CRASH_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/CRASH_WEBHOOK_URL
VITE_SLACK_FILES_UPDATE=https://hooks.slack.com/services/YOUR/SLACK/FILES_UPDATE_WEBHOOK_URL
SLACK_FILES_UPDATE=https://hooks.slack.com/services/YOUR/SLACK/FILES_UPDATE_WEBHOOK_URL

# ── Web Push (VAPID) ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@sunvinesolar.com

